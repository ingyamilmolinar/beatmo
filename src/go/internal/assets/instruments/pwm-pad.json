{
  "schema_version": "0.0.1",
  "id": "pwm-pad",
  "name": "PWM Pad",
  "category": "modular",
  "notes": "pwmPadSeed: a warm chorused poly pad — a detuned square-wave ensemble (the\nJuno/PWM shimmer) under a slow filter LFO for gentle movement, with a soft pad\nattack and a long release.",
  "render": {
    "seconds": 1.25,
    "amplitude": 0.6052,
    "gate_tail": 0,
    "melodic": true
  },
  "stages": {
    "amp_env": {
      "v": 1,
      "on": true,
      "values": {
        "amp_attack": 0.3,
        "amp_curve": 1,
        "amp_decay": 0.4,
        "amp_release": 1.1,
        "amp_sustain": 0.85
      }
    },
    "core": {
      "v": 1,
      "on": true,
      "values": {
        "gain": 0.6,
        "noise_draws": 1,
        "noise_prelude": 0,
        "osc_detune": 0,
        "osc_octave": 0,
        "pitch": 0,
        "voice_freq_hz": 0
      }
    },
    "drive": {
      "v": 1,
      "on": true,
      "values": {
        "drive": 0
      }
    },
    "filter": {
      "v": 1,
      "on": true,
      "values": {
        "filter_cutoff": 4000,
        "filter_resonance": 1,
        "filter_type": 0
      }
    },
    "finish": {
      "v": 1,
      "on": true,
      "values": {
        "out_clamp": 1.5,
        "post_body": 0,
        "post_brightness": 0,
        "post_darken": 0,
        "post_decay": 1,
        "post_decay_rate": 8,
        "post_drive": 0,
        "post_pitch": 0
      }
    },
    "lfo": {
      "v": 1,
      "on": true,
      "values": {
        "lfo_delay": 0,
        "lfo_depth": 0.35,
        "lfo_rate": 0.5,
        "lfo_target": 2
      },
      "notes": "lfo_enabled: slow filter movement (PWM-ish shimmer)"
    },
    "unison": {
      "v": 1,
      "on": true,
      "values": {
        "ens_humanize": 0,
        "ens_jitter": 0,
        "ens_scatter": 0,
        "ens_vib_depth": 0,
        "ens_vib_rate": 0,
        "unison_detune": 12,
        "unison_drift_depth": 6,
        "unison_drift_rate": 0.5,
        "unison_mix": 0.75,
        "unison_voices": 5
      }
    }
  },
  "source": {
    "type": "osc.wavetable",
    "v": 1,
    "on": true,
    "values": {
      "osc_type": 2
    },
    "notes": "osc_enabled: square\nosc_type: square"
  }
}
