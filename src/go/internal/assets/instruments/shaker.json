{
  "schema_version": "0.0.1",
  "id": "shaker",
  "name": "Shaker",
  "category": "modular",
  "notes": "shaker: no gen1_cym_noise_d and no gen1_wave — see the block comment above.",
  "render": {
    "seconds": 0.3,
    "amplitude": 1,
    "gate_tail": 0,
    "melodic": false
  },
  "stages": {
    "amp_env": {
      "v": 1,
      "on": false,
      "values": {
        "amp_attack": 0.005,
        "amp_curve": 1,
        "amp_decay": 0.3,
        "amp_release": 0.2,
        "amp_sustain": 0.6
      }
    },
    "core": {
      "v": 1,
      "on": true,
      "values": {
        "gain": 1,
        "noise_draws": 1,
        "noise_prelude": 0,
        "osc_detune": 0,
        "osc_octave": 0,
        "pitch": 0,
        "voice_freq_hz": 0
      }
    },
    "drive": {
      "v": 1,
      "on": true,
      "values": {
        "drive": 0
      }
    },
    "filter": {
      "v": 1,
      "on": false,
      "values": {
        "filter_cutoff": 8000,
        "filter_resonance": 0.707,
        "filter_type": 0
      }
    },
    "finish": {
      "v": 1,
      "on": true,
      "values": {
        "out_clamp": 0,
        "post_body": 0,
        "post_brightness": 0,
        "post_darken": 0,
        "post_decay": 1,
        "post_decay_rate": 15,
        "post_drive": 0,
        "post_pitch": 0
      },
      "notes": "out_clamp: no output limit (these voices never had one)"
    }
  },
  "source": {
    "type": "osc.wavetable",
    "v": 1,
    "on": false,
    "values": {
      "osc_type": 0
    }
  },
  "layers": [
    {
      "type": "cym.shaker",
      "v": 1,
      "on": true,
      "values": {
        "cym_env_fast": 200,
        "cym_env_tail": 25,
        "cym_noise_m": 0.5,
        "cym_tone_m": 0.6,
        "cym_tune": 1
      }
    }
  ]
}
