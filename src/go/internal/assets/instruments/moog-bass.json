      "v": 1,
      "on": true,
      "values": {
        "env_fast_mix": 1,
        "env_fast_rate": 0,
        "env_tail_mix": 0,
        "env_tail_rate": 0,
        "filt_alpha": 0,
        "filt_freq": 1000,
        "filt_q": 0.707,
        "filt_type": 0,
        "freq": 1,
        "freq_mode": 0,
        "gain": 0.4,
        "phase": 0,
        "phase_mode": 0,
        "wave": 0
      },
      "notes": "gen1_source: sine sub for body weight"
    }
  ]
