{
  "schema_version": "0.0.1",
  "id": "snare-lofi",
  "name": "Lo-Fi Snare",
  "category": "modular",
  "notes": "snareFatOriginalSeed is that original fat-bottom sound, verbatim; snare-lofi\nand snare-ghost still build on it (snare-fat itself was retuned for crack,\nsee snareFatSeed below).",
  "render": {
    "seconds": 0.3,
    "amplitude": 1,
    "gate_tail": 0,
    "melodic": false
  },
  "stages": {
    "amp_env": {
      "v": 1,
      "on": false,
      "values": {
        "amp_attack": 0.005,
        "amp_curve": 1,
        "amp_decay": 0.3,
        "amp_release": 0.2,
        "amp_sustain": 0.6
      }
    },
    "core": {
      "v": 1,
      "on": true,
      "values": {
        "gain": 1,
        "noise_draws": 1,
        "noise_prelude": 0,
        "osc_detune": 0,
        "osc_octave": 0,
        "pitch": 0,
        "voice_freq_hz": 186
      }
    },
    "drive": {
      "v": 1,
      "on": true,
      "values": {
        "drive": 0
      }
    },
    "filter": {
      "v": 1,
      "on": false,
      "values": {
        "filter_cutoff": 8000,
        "filter_resonance": 0.707,
        "filter_type": 0
      }
    },
    "finish": {
      "v": 1,
      "on": true,
      "values": {
        "out_clamp": 0,
        "post_body": 0,
        "post_brightness": 0,
        "post_darken": 0,
        "post_decay": 1,
        "post_decay_rate": 8,
        "post_drive": 0,
        "post_pitch": 0
      },
      "notes": "out_clamp: no output limit (these voices never had one)"
    }
  },
  "source": {
    "type": "osc.wavetable",
    "v": 1,
    "on": false,
    "values": {
      "osc_type": 0
    }
  },
  "layers": [
    {
      "type": "snare.main",
      "v": 1,
      "on": true,
      "values": {
        "freq": 1,
        "freq_mode": 0,
        "snare_attack": 0.5,
        "snare_noise_d": 7,
        "snare_noise_m": 0.56,
        "snare_tail_d": 10,
        "snare_tone2": 280,
        "snare_tone_d": 46,
        "snare_tone_m": 1.12,
        "snare_tune": 0.55,
        "snare_wire_m": 0.8,
        "wave": 0
      },
      "notes": "gen1_snare_variant: base snare\ngen1_wave: sine body"
    }
  ],
  "fx": [
    {
      "type": "fx.bitcrusher",
      "v": 1,
      "on": true,
      "values": {
        "bits": 4,
        "mix": 1,
        "rate": 1
      }
    },
    {
      "type": "fx.filter",
      "v": 1,
      "on": true,
      "values": {
        "cutoff": 3000,
        "mix": 1,
        "mode": 0,
        "q": 0.707
      }
    }
  ]
}
