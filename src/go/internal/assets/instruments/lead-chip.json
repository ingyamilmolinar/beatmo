{
  "schema_version": "0.0.1",
  "id": "lead-chip",
  "name": "Chip Lead",
  "category": "modular",
  "notes": "leadChipSeed: an 8-bit chiptune square lead — a raw square wave, minimal\nfiltering, a snappy envelope and a fast vibrato (the NES \"trill\" character).",
  "render": {
    "seconds": 0.75,
    "amplitude": 0.468,
    "gate_tail": 0,
    "melodic": true
  },
  "stages": {
    "amp_env": {
      "v": 1,
      "on": true,
      "values": {
        "amp_attack": 0.001,
        "amp_curve": 1,
        "amp_decay": 0.08,
        "amp_release": 0.05,
        "amp_sustain": 0.7
      }
    },
    "core": {
      "v": 1,
      "on": true,
      "values": {
        "gain": 0.7,
        "noise_draws": 1,
        "noise_prelude": 0,
        "osc_detune": 0,
        "osc_octave": 0,
        "pitch": 0,
        "voice_freq_hz": 0
      }
    },
    "drive": {
      "v": 1,
      "on": true,
      "values": {
        "drive": 0
      }
    },
    "filter": {
      "v": 1,
      "on": true,
      "values": {
        "filter_cutoff": 9000,
        "filter_resonance": 0.8,
        "filter_type": 0
      },
      "notes": "filter_type: 9000 (not 12000): a 12 kHz cutoff sits AT the preview render's Nyquist\n(24 kHz SR) and blew the biquad up to NaN — 9 kHz is still plenty bright for\na chip lead and safely below Nyquist at every render rate."
    },
    "finish": {
      "v": 1,
      "on": true,
      "values": {
        "out_clamp": 1.5,
        "post_body": 0,
        "post_brightness": 0,
        "post_darken": 0,
        "post_decay": 1,
        "post_decay_rate": 8,
        "post_drive": 0,
        "post_pitch": 0
      }
    },
    "lfo": {
      "v": 1,
      "on": true,
      "values": {
        "lfo_delay": 0.05,
        "lfo_depth": 0.03,
        "lfo_rate": 7,
        "lfo_target": 1
      }
    },
    "unison": {
      "v": 1,
      "on": true,
      "values": {
        "ens_humanize": 0,
        "ens_jitter": 0,
        "ens_scatter": 0,
        "ens_vib_depth": 0,
        "ens_vib_rate": 0,
        "unison_detune": 0,
        "unison_drift_depth": 0,
        "unison_drift_rate": 0,
        "unison_mix": 0.5,
        "unison_voices": 1
      }
    }
  },
  "source": {
    "type": "osc.wavetable",
    "v": 1,
    "on": true,
    "values": {
      "osc_type": 2
    },
    "notes": "osc_enabled: square\nosc_type: square"
  }
}
