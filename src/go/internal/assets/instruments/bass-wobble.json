{
  "schema_version": "0.0.1",
  "id": "bass-wobble",
  "name": "Wobble Bass",
  "category": "modular",
  "notes": "bassWobbleSeed: a dubstep wobble bass — a saw an octave down through a low\nresonant low-pass whose cutoff is swept by an LFO (the wobble), plus drive.\nNO osc_octave: every melodic instrument defaults to the same pitch (A3, node\npitch 0). It's a bass by timbre (low resonant filter) — pitch nodes down for\na bassline. (Existing bass-guitar/808/etc. keep their -1 octave; unchanged.)",
  "render": {
    "seconds": 0.75,
    "amplitude": 0.4032,
    "gate_tail": 0,
    "melodic": true
  },
  "stages": {
    "amp_env": {
      "v": 1,
      "on": true,
      "values": {
        "amp_attack": 0.005,
        "amp_curve": 1,
        "amp_decay": 0.3,
        "amp_release": 0.15,
        "amp_sustain": 0.85
      }
    },
    "core": {
      "v": 1,
      "on": true,
      "values": {
        "gain": 0.9,
        "noise_draws": 1,
        "noise_prelude": 0,
        "osc_detune": 0,
        "osc_octave": 0,
        "pitch": 0,
        "voice_freq_hz": 0
      }
    },
    "drive": {
      "v": 1,
      "on": true,
      "values": {
        "drive": 0.35
      }
    },
    "filter": {
      "v": 1,
      "on": true,
      "values": {
        "filter_cutoff": 700,
        "filter_resonance": 4,
        "filter_type": 0
      }
    },
    "finish": {
      "v": 1,
      "on": true,
      "values": {
        "out_clamp": 1.5,
        "post_body": 0,
        "post_brightness": 0,
        "post_darken": 0,
        "post_decay": 1,
        "post_decay_rate": 8,
        "post_drive": 0,
        "post_pitch": 0
      }
    },
    "lfo": {
      "v": 1,
      "on": true,
      "values": {
        "lfo_delay": 0,
        "lfo_depth": 0.9,
        "lfo_rate": 4,
        "lfo_target": 2
      },
      "notes": "lfo_depth: cutoff wobble\nlfo_enabled: cutoff wobble\nlfo_rate: cutoff wobble\nlfo_target: cutoff wobble"
    }
  },
  "source": {
    "type": "osc.wavetable",
    "v": 1,
    "on": true,
    "values": {
      "osc_type": 1
    }
  }
}
